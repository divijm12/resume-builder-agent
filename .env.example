# Copy this file to .env and fill in your own values.
# Nothing here is shared or hardcoded to any specific account.

# Required for every pipeline stage (ingest/score/tailor/cover letter/etc).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required only for Stage 5 (find a hiring contact). Free tier is enough
# at personal-job-search volume (50 credits/month). Sign up at hunter.io.
HUNTER_API_KEY=

# Required only for sending drafted outreach emails (dashboard's "Send
# email" button). Enable 2-Step Verification on your Google account,
# then generate an App Password at myaccount.google.com/apppasswords.
# GMAIL_APP_PASSWORD is the 16-character app password, not your real
# Google account password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
